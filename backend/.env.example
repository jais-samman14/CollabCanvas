# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
# Local: mongodb://127.0.0.1:27017/collabcanvas
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/collabcanvas?retryWrites=true&w=majority
MONGO_URL=mongodb://127.0.0.1:27017/collabcanvas

# JWT
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# Redis (Optional in development: falls back to in-memory store if unavailable)
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Email via Brevo HTTPS API (works on Render free tier where SMTP ports 25/465/587 are blocked)
# 1) Create a free Brevo account -> https://www.brevo.com
# 2) SMTP & API -> API keys -> Create key
# 3) Senders & IP -> verify your EMAIL_FROM address
# Leave blank in local development to log OTPs directly in the backend terminal.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=CollabCanvas Team
